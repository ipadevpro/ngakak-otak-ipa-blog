
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Base rules
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn();
    }
    
    // Topics collection - admins can write, everyone can read
    match /topics/{topicId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Stories collection - admins can write, everyone can read
    match /stories/{storyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      
      // Allow anyone to update only the likes and likedBy fields
      allow update: if 
        !isAdmin() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']);
    }
    
    // Feedback collection - anyone can create, admins can read all
    match /feedback/{feedbackId} {
      allow create: if true; // Allow anonymous feedback
      allow read: if isAdmin(); // Only admins can read all feedback
      
      // Users can read their own feedback
      allow read: if resource.data.userId == request.auth.uid;
    }
  }
}
